# Core
PORT=8080
DATA_DIR=./data
SITE_NAME=MyPrintables
APP_URL=http://localhost:8080
SECURE_COOKIES=false
TRUSTED_PROXY=
REGISTRATION_ENABLED=true
EMAIL_VERIFICATION_ENABLED=false
MAX_UPLOAD_MB=1024
AUTO_MIGRATE=true
LOG_LEVEL=info

# Optional unattended bootstrap (only used when no users exist)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional SMTP; required only when email verification is enabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=MyPrintables <no-reply@localhost>
SMTP_TLS=true
