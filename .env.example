# Core
PORT=8200
DATA_DIR=./data
SITE_NAME=MyPrintables
APP_URL=http://localhost:8200
SECURE_COOKIES=false
TRUSTED_PROXY=
REGISTRATION_ENABLED=true
EMAIL_VERIFICATION_ENABLED=false
MAX_UPLOAD_MB=1024
AUTO_MIGRATE=true
LOG_LEVEL=info

# Optional unattended bootstrap (only used when no users exist)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional SMTP; required only when email verification is enabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=MyPrintables <no-reply@localhost>
SMTP_TLS=true

# Optional MCP server (LLM tools). User API keys are created in Settings.
MCP_ENABLED=false
# Optional read-only public credential:
MCP_TOKEN=
